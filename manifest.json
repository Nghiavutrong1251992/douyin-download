{
  "manifest_version": 3,
  "name": "Douyin to Facebook Auto-Pilot",
  "version": "1.1.0",
  "description": "Lấy ảnh HD, video không watermark từ Douyin, dịch & viết lại bằng DeepSeek AI và chuẩn bị đăng lên Facebook Fanpage.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "sidePanel",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.iesdouyin.com/*",
    "*://*.douyinpic.com/*",
    "*://*.bytedance.com/*",
    "*://*.byteimg.com/*",
    "*://*.bytegoofy.com/*",
    "*://*.ibyteimg.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.pstatp.com/*",
    "https://api.deepseek.com/*",
    "https://graph.facebook.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Mở Douyin → FB ở sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.douyin.com/*",
        "*://douyin.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject_main.js",
        "icons/*",
        "lib/*"
      ],
      "matches": ["*://*.douyin.com/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules/referer_rules.json"
      }
    ]
  }
}
